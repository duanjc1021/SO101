+"""Input/output transforms for the SO101 single-arm robot (pi0.5 fine-tuning).
+
+SO101 has a single 6-DOF arm (shoulder_pan, shoulder_lift, elbow_flex, wrist_flex,
+wrist_roll, gripper) and two RGB cameras: a top/scene view and a wrist view. pi0
+models accept three image slots (one third-person + two wrist), so we map:
+
+    top   -> base_0_rgb
+    wrist -> left_wrist_0_rgb
+    (none -> right_wrist_0_rgb, zero-padded and masked out)
+
+This mirrors openpi's LIBERO transforms (also single-arm, 2 cameras) — the only
+SO101-specific change is the action dimension: 6, not 7.
+"""
+
+import dataclasses
+
+import einops
+import numpy as np
+
+from openpi import transforms
+from openpi.models import model as _model
+
+# SO101 has 6 joints (shoulder_pan, shoulder_lift, elbow_flex, wrist_flex, wrist_roll, gripper).
+SO101_ACTION_DIM = 6
+
+
+def make_so101_example() -> dict:
+    """A random input example matching the keys the policy server receives at inference."""
+    return {
+        "observation/state": np.random.rand(SO101_ACTION_DIM),
+        "observation/image": np.random.randint(256, size=(224, 224, 3), dtype=np.uint8),
+        "observation/wrist_image": np.random.randint(256, size=(224, 224, 3), dtype=np.uint8),
+        "prompt": "put the blue cube in the brown box",
+    }
+
+
+def _parse_image(image) -> np.ndarray:
+    """LeRobot stores images as float32 (C,H,W); the model wants uint8 (H,W,C)."""
+    image = np.asarray(image)
+    if np.issubdtype(image.dtype, np.floating):
+        image = (255 * image).astype(np.uint8)
+    if image.shape[0] == 3:
+        image = einops.rearrange(image, "c h w -> h w c")
+    return image
+
+
+@dataclasses.dataclass(frozen=True)
+class SO101Inputs(transforms.DataTransformFn):
+    """Convert SO101 dataset/inference inputs into the model's expected format."""
+
+    # Determines which model will be used. Do not change this for your own dataset.
+    model_type: _model.ModelType
+
+    def __call__(self, data: dict) -> dict:
+        base_image = _parse_image(data["observation/image"])
+        wrist_image = _parse_image(data["observation/wrist_image"])
+
+        inputs = {
+            "state": data["observation/state"],
+            "image": {
+                "base_0_rgb": base_image,
+                "left_wrist_0_rgb": wrist_image,
+                # SO101 has no right wrist camera: pad with zeros and mask it out below.
+                "right_wrist_0_rgb": np.zeros_like(base_image),
+            },
+            "image_mask": {
+                "base_0_rgb": np.True_,
+                "left_wrist_0_rgb": np.True_,
+                # Padding image is masked for pi0/pi0.5 (only pi0-FAST keeps it True).
+                "right_wrist_0_rgb": np.True_ if self.model_type == _model.ModelType.PI0_FAST else np.False_,
+            },
+        }
+
+        # Actions are only present during training (padded to model dim later by PadStatesAndActions).
+        if "actions" in data:
+            inputs["actions"] = data["actions"]
+
+        # Language instruction (pi0.5 is language-conditioned).
+        if "prompt" in data:
+            inputs["prompt"] = data["prompt"]
+
+        return inputs
+
+
+@dataclasses.dataclass(frozen=True)
+class SO101Outputs(transforms.DataTransformFn):
+    """Convert model outputs back to SO101 actions (inference only)."""
+
+    def __call__(self, data: dict) -> dict:
+        # Strip the padding the model added: SO101 uses the first 6 action dims.
+        return {"actions": np.asarray(data["actions"][:, :SO101_ACTION_DIM])}
